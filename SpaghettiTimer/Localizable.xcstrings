    "Create your own — set a duration, or pick the clock time it should end at." : {
      "comment" : "Hint text for a button that lets the user create a new timer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مؤقتك الخاص — حدّد المدة أو اختر وقت انتهائه على الساعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създайте свой — задайте времетраене или изберете часа, в който да свърши."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte si vlastní — nastavte délku nebo vyberte čas, kdy má skončit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav din egen — angiv en varighed, eller vælg klokkeslættet, den skal slutte på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle deinen eigenen — Dauer festlegen oder die Uhrzeit wählen, zu der er enden soll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε το δικό σας — ορίστε διάρκεια ή επιλέξτε την ώρα που θα τελειώσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea el tuyo: define una duración o elige la hora a la que debe terminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo omasi – aseta kesto tai valitse kellonaika, jolloin sen pitää päättyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez le vôtre : définissez une durée ou choisissez l’heure de fin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
