    "Scroll hours, minutes and seconds. Start lights up as soon as it’s not zero." : {
      "comment" : "Body text of a tutorial step in the \"New Timer\" tour, explaining how to use the duration wheel.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر الساعات والدقائق والثواني. يضيء زر البدء بمجرد أن تتجاوز القيمة الصفر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превъртете часовете, минутите и секундите. „Старт“ светва веднага щом стойността не е нула."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posouvejte hodiny, minuty a sekundy. Tlačítko Start se rozsvítí, jakmile hodnota není nula."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rul gennem timer, minutter og sekunder. Start lyser op, så snart værdien ikke er nul."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blättere durch Stunden, Minuten und Sekunden. „Start“ leuchtet auf, sobald der Wert nicht null ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κυλήστε ώρες, λεπτά και δευτερόλεπτα. Η «Έναρξη» ανάβει μόλις η τιμή δεν είναι μηδέν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza horas, minutos y segundos. «Iniciar» se enciende en cuanto el valor deja de ser cero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vieritä tunteja, minuutteja ja sekunteja. Aloita-painike syttyy heti, kun arvo ei ole nolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler heures, minutes et secondes. « Démarrer » s’allume dès que la valeur n’est pas nulle."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görgesse az órákat, perceket és másodperceket. Az Indítás akkor világít, ha az érték nem nulla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri ore, minuti e secondi. «Avvia» si accende appena il valore non è zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時・分・秒をスクロールします。ゼロでなくなると「開始」が点灯します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bla gjennom timer, minutter og sekunder. Start lyser opp så snart verdien ikke er null."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll door uren, minuten en seconden. 'Start' licht op zodra de waarde niet nul is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewijaj godziny, minuty i sekundy. Przycisk Start zaświeci się, gdy wartość przestanie być zerem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorra horas, minutos e segundos. «Iniciar» acende assim que o valor deixar de ser zero."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derulează orele, minutele și secundele. „Pornește” se aprinde de îndată ce valoarea nu mai e zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутите часы, минуты и секунды. Кнопка «Старт» загорится, как только значение станет больше нуля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posúvajte hodiny, minúty a sekundy. Tlačidlo Štart sa rozsvieti, len čo hodnota nie je nula."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomikajte ure, minute in sekunde. Gumb Začni zasveti, takoj ko vrednost ni nič."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomerajte sate, minute i sekunde. „Počni“ zasvetli čim vrednost nije nula."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bläddra bland timmar, minuter och sekunder. Start tänds så snart värdet inte är noll."
          }
        }
      }
    },
