    "A name like “Pasta” shows on the timer card, the widget and the Dynamic Island." : {
      "comment" : "Hint text for naming a timer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم مثل «Pasta» يظهر على بطاقة المؤقت وفي الأداة وفي الجزيرة الديناميكية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Име като „Pasta“ се показва върху картата на таймера, в приспособлението и в Dynamic Island."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název jako „Pasta“ se zobrazí na kartě časovače, ve widgetu i v Dynamic Islandu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et navn som “Pasta” vises på timerkortet, i widgetten og i Dynamic Island."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Name wie „Pasta“ erscheint auf der Timer-Karte, im Widget und in der Dynamic Island."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα όνομα όπως «Pasta» εμφανίζεται στην κάρτα του χρονομέτρου, στο widget και στο Dynamic Island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre como «Pasta» aparece en la tarjeta del temporizador, el widget y la Dynamic Island."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimi kuten ”Pasta” näkyy ajastimen kortissa, widgetissä ja Dynamic Islandissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom comme « Pasta » s’affiche sur la carte du minuteur, dans le widget et dans la Dynamic Island."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Pasta” típusú név megjelenik az időzítő kártyáján, a modulban és a Dynamic Islanden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome come «Pasta» compare sulla scheda del timer, nel widget e nella Dynamic Island."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Pasta」のような名前は、タイマーのカード、ウィジェット、Dynamic Island に表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et navn som «Pasta» vises på tidtakerkortet, i modulen og i Dynamic Island."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een naam als 'Pasta' verschijnt op de timerkaart, in de widget en in het Dynamic Island."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa taka jak „Pasta” pojawia się na kafelku minutnika, w widżecie i w Dynamic Island."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um nome como «Pasta» aparece no cartão do temporizador, no widget e na Dynamic Island."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nume precum „Pasta” apare pe cartela temporizatorului, în widget și în Dynamic Island."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Название вроде «Pasta» отображается на карточке таймера, в виджете и в Dynamic Island."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Názov ako „Pasta“ sa zobrazí na karte časovača, vo widgete aj v Dynamic Islande."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ime, kot je »Pasta«, se prikaže na kartici časovnika, v pripomočku in v Dynamic Islandu."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naziv poput „Pasta“ prikazuje se na kartici tajmera, u vidžetu i u Dynamic Islandu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett namn som \"Pasta\" visas på timerkortet, i widgeten och i Dynamic Island."
          }
        }
      }
    },
    "A running timer lives at the top of this screen. Pause or dismiss it without leaving the grid." : {
      "comment" : "Text for a tutorial step that shows a running timer at the top of the screen, with a hint to pause or dismiss it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر المؤقت العامل في أعلى هذه الشاشة. أوقفه مؤقتًا أو أغلقه دون مغادرة الشبكة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работещият таймер стои в горната част на екрана. Поставете го на пауза или го премахнете, без да напускате мрежата."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běžící časovač je v horní části obrazovky. Pozastavte ho nebo zavřete, aniž byste opustili mřížku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kørende timer ligger øverst på skærmen. Sæt den på pause, eller luk den uden at forlade gitteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein laufender Timer sitzt oben auf diesem Bildschirm. Pausiere oder schließe ihn, ohne das Raster zu verlassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χρονόμετρο που εκτελείται βρίσκεται στο πάνω μέρος της οθόνης. Κάντε παύση ή κλείστε το χωρίς να φύγετε από το πλέγμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El temporizador en marcha se queda arriba de esta pantalla. Ponlo en pausa o ciérralo sin salir de la cuadrícula."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnissä oleva ajastin näkyy näytön yläreunassa. Keskeytä tai sulje se poistumatta ruudukosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuteur en cours reste en haut de cet écran. Mettez-le en pause ou fermez-le sans quitter la grille."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A futó időzítő a képernyő tetején marad. Szüneteltesse vagy zárja be anélkül, hogy elhagyná a rácsot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timer in corso resta in cima a questa schermata. Mettilo in pausa o chiudilo senza uscire dalla griglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のタイマーはこの画面の上部に表示されます。グリッドを離れずに一時停止したり閉じたりできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidtaker som går, ligger øverst på denne skjermen. Sett den på pause, eller lukk den uten å forlate rutenettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een lopende timer staat bovenaan dit scherm. Pauzeer of sluit hem zonder het raster te verlaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działający minutnik znajduje się na górze tego ekranu. Wstrzymaj go lub zamknij bez opuszczania siatki."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um temporizador a decorrer fica no topo deste ecrã. Coloque-o em pausa ou feche-o sem sair da grelha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un temporizator activ stă în partea de sus a ecranului. Pune-l pe pauză sau închide-l fără să părăsești grila."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущенный таймер находится вверху этого экрана. Поставьте его на паузу или закройте, не покидая сетку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bežiaci časovač je v hornej časti obrazovky. Pozastavte ho alebo zavrite bez toho, aby ste opustili mriežku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delujoč časovnik je na vrhu tega zaslona. Zaustavite ga ali zaprite, ne da bi zapustili mrežo."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivan tajmer stoji na vrhu ovog ekrana. Pauzirajte ga ili zatvorite bez napuštanja mreže."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pågående timer ligger högst upp på den här skärmen. Pausa eller stäng den utan att lämna rutnätet."
          }
        }
      }
    },
    "Add the widget" : {
      "comment" : "Text displayed in a tutorial step when adding the widget to the home screen.",
      "isCommentAutoGenerated" : true,
