        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przełącz na „Godzinę zakończenia” i wybierz, kiedy minutnik ma się skończyć — na przykład o 11:00. Czas trwania ustawi się sam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude para «Hora de fim» e escolha quando o temporizador deve terminar — por exemplo, às 11:00. A duração é definida por si."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comută la „Ora de final” și alege când să se încheie temporizatorul — de exemplu, la ora 11:00. Durata este calculată pentru tine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключитесь на «Время окончания» и выберите, когда таймер должен завершиться — например, в 11:00. Длительность рассчитается сама."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepnite na „Čas konca“ a vyberte, kedy má časovač skončiť — napríklad o 11:00. Trvanie nastavíme za vás."
          }
        },
        "sl" : {
          "stringUnit" : {
