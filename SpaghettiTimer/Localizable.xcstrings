    "Great for intervals — the timer restarts itself after a cooldown you choose." : {
      "comment" : "Description of a tutorial step where the user learns about the \"auto-restart\" feature of a timer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثالي للفترات المتكررة — يعيد المؤقت تشغيل نفسه بعد فترة توقّف تختارها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чудесно за интервали — таймерът се рестартира сам след избрано от вас изчакване."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skvělé pro intervaly — časovač se sám restartuje po prodlevě, kterou zvolíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt til intervaller — timeren starter sig selv igen efter en pause, du vælger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal für Intervalle — der Timer startet nach einer von dir gewählten Pause neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ιδανικό για διαστήματα — το χρονόμετρο ξεκινά ξανά μόνο του μετά από παύση που επιλέγετε."
          }
        },
        "es" : {
          "stringUnit" : {
