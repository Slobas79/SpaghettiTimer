    "Loop any timer automatically after a cooldown — perfect for intervals and batches." : {
      "comment" : "A description of the \"Auto-restart\" feature in the paywall.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كرّر أي مؤقت تلقائيًا بعد فترة توقّف — مثالي للفترات والدفعات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повтаряйте всеки таймер автоматично след изчакване — идеално за интервали и партиди."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte kterýkoli časovač po prodlevě automaticky běžet dokola — ideální pro intervaly a dávky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kør en hvilken som helst timer automatisk igen efter en pause — perfekt til intervaller og portioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass jeden Timer nach einer Pause automatisch weiterlaufen — perfekt für Intervalle und Chargen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
