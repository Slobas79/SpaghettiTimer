    "Touch and hold the island to expand it — check the countdown, pause or dismiss, without opening the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس الجزيرة مع الاستمرار لتوسيعها — تابع العد التنازلي أو أوقف المؤقت مؤقتًا أو ألغِه دون فتح التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете и задръжте острова, за да го разгънете — вижте обратното броене, поставете на пауза или отхвърлете, без да отваряте приложението."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotykem a podržením ostrůvek rozbalíte — zkontrolujte odpočet, pozastavte nebo zrušte časovač bez otevření aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold på øen for at folde den ud – se nedtællingen, sæt på pause eller afvis uden at åbne appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Insel gedrückt, um sie zu erweitern – Countdown prüfen, pausieren oder schließen, ohne die App zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε παρατεταμένα το νησί για να το αναπτύξετε — δείτε την αντίστροφη μέτρηση, κάντε παύση ή απόρριψη, χωρίς να ανοίξετε την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la isla para ampliarla: consulta la cuenta atrás, ponlo en pausa o descártalo sin abrir la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketa saarta pitkään laajentaaksesi sen – tarkista laskuri, keskeytä tai hylkää avaamatta sovellusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’île de manière prolongée pour l’agrandir : consultez le compte à rebours, mettez en pause ou fermez, sans ouvrir l’app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érintsd meg és tartsd nyomva a szigetet a kinyitásához – nézd meg a visszaszámlálást, szüneteltesd vagy zárd be az alkalmazás megnyitása nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta l’isola per espanderla: controlla il conto alla rovescia, metti in pausa o chiudi, senza aprire l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイランドを長押しすると展開します。アプリを開かずに、カウントダウンの確認、一時停止、終了ができます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på øya for å utvide den – se nedtellingen, sett på pause eller avvis uten å åpne appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het eiland ingedrukt om het uit te vouwen — bekijk het aftellen, pauzeer of sluit, zonder de app te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij i przytrzymaj wyspę, aby ją rozwinąć — sprawdź odliczanie, wstrzymaj lub zamknij bez otwierania aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premida a ilha para a expandir — veja a contagem decrescente, coloque em pausa ou dispense, sem abrir a app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge și ține apăsat pe insulă pentru a o extinde — vezi numărătoarea inversă, pune pe pauză sau închide, fără a deschide aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте остров, чтобы развернуть его, — смотрите обратный отсчёт, ставьте на паузу или закрывайте, не открывая приложение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotykom a podržaním ostrovček rozbalíte — skontrolujte odpočet, pozastavte alebo zrušte časovač bez otvorenia aplikácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotaknite se otoka in ga pridržite, da ga razširite – preverite odštevanje, začasno ustavite ali zavrzite brez odpiranja aplikacije."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite i zadržite ostrvo da biste ga proširili — proverite odbrojavanje, pauzirajte ili odbacite bez otvaranja aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll på ön för att expandera den – se nedräkningen, pausa eller avfärda utan att öppna appen."
          }
        }
      }
    },
