    "Pin a tile that always counts down to the next full hour — no setting it each time." : {
      "comment" : "A feature description for the \"To next hour\" feature in the paywall.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت بطاقة تعدّ دائمًا تنازليًا حتى الساعة التالية — دون ضبطها في كل مرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закачете плочка, която винаги отброява до следващия кръгъл час — без да я настройвате всеки път."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připněte si dlaždici, která vždy odpočítává do další celé hodiny — bez nastavování pokaždé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fastgør et felt, der altid tæller ned til næste hele time — uden at indstille det hver gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hefte eine Kachel an, die immer bis zur nächsten vollen Stunde herunterzählt — ohne sie jedes Mal einzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καρφιτσώστε ένα πλακίδιο που μετρά πάντα αντίστροφα μέχρι την επόμενη ακριβή ώρα — χωρίς να το ρυθμίζετε κάθε φορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija una casilla que siempre cuenta atrás hasta la siguiente hora en punto, sin configurarla cada vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinnitä ruutu, joka laskee aina seuraavaan tasatuntiin – ilman että asetat sitä joka kerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épinglez une tuile qui décompte toujours jusqu’à l’heure pile suivante, sans la régler à chaque fois."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzítsen egy csempét, amely mindig a következő egész óráig számol vissza — nem kell mindig beállítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa un riquadro che conta sempre alla rovescia fino all’ora piena successiva, senza impostarlo ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の正時まで常にカウントダウンするタイルをピン留め — 毎回設定する必要はありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fest en rute som alltid teller ned til neste hele time – uten at du stiller den hver gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een tegel vast die altijd aftelt tot het volgende hele uur — zonder hem elke keer in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypnij kafelek, który zawsze odlicza do najbliższej pełnej godziny — bez ustawiania za każdym razem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe um mosaico que faz sempre a contagem decrescente até à hora seguinte — sem o definir de cada vez."
          }
        },
