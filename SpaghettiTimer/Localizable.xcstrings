    "Timers start instantly with one tap — no setup each time." : {
      "comment" : "Body text of a tutorial step in the \"Home\" tour, explaining how timers start.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ المؤقتات فورًا بنقرة واحدة — دون إعداد في كل مرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймерите тръгват веднага с едно докосване — без настройки всеки път."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovače se spustí okamžitě jediným klepnutím — bez nastavování pokaždé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timere starter med det samme med ét tryk — ingen opsætning hver gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer starten sofort mit einem Tipp — ohne jedes Mal etwas einzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα χρονόμετρα ξεκινούν αμέσως με ένα πάτημα — χωρίς ρυθμίσεις κάθε φορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temporizadores empiezan al instante con un toque, sin configurar nada cada vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajastimet käynnistyvät heti yhdellä napautuksella — ei asetuksia joka kerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les minuteurs démarrent instantanément d’une simple touche, sans réglage à chaque fois."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az időzítők egyetlen koppintással azonnal elindulnak — nem kell mindig beállítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I timer partono subito con un tocco, senza impostazioni ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
