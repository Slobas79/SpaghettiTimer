          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite cualquier temporizador automáticamente tras un descanso: perfecto para intervalos y tandas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista mikä tahansa ajastin automaattisesti tauon jälkeen – täydellinen intervalleihin ja eriin."
