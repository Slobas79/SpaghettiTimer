    "Adds a “To next hour” tile that always counts down to the next full hour." : {
      "comment" : "A description of how pinning a timer works.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف بطاقة «إلى الساعة التالية» تعدّ دائمًا تنازليًا حتى الساعة التالية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавя плочка „До следващия час“, която винаги отброява до следващия кръгъл час."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá dlaždici „Do další hodiny“, která vždy odpočítává do další celé hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer et felt “Til næste time”, der altid tæller ned til næste hele time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine Kachel „Bis zur nächsten Stunde“ hinzu, die immer bis zur nächsten vollen Stunde herunterzählt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει ένα πλακίδιο «Μέχρι την επόμενη ώρα» που μετρά πάντα αντίστροφα μέχρι την επόμενη ακριβή ώρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una casilla «A la siguiente hora» que siempre cuenta atrás hasta la siguiente hora en punto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää ”Seuraavaan tasatuntiin” -ruudun, joka laskee aina seuraavaan tasatuntiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une tuile « Jusqu’à l’heure suivante » qui décompte toujours jusqu’à l’heure pile suivante."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozzáad egy „Következő egész óráig” csempét, amely mindig a következő egész óráig számol vissza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un riquadro «Alla prossima ora» che conta sempre alla rovescia fino all’ora piena successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の正時まで常にカウントダウンする「次の正時まで」タイルを追加します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger til en «Til neste time»-rute som alltid teller ned til neste hele time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een tegel 'Tot het volgende uur' toe die altijd aftelt tot het volgende hele uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje kafelek „Do pełnej godziny”, który zawsze odlicza do najbliższej pełnej godziny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um mosaico «Até à hora seguinte» que faz sempre a contagem decrescente até à hora seguinte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă o casetă „Până la ora următoare” care numără mereu invers până la ora fixă următoare."
