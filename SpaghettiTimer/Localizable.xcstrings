        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет плитку «До следующего часа», которая всегда ведёт отсчёт до следующего целого часа."
          }
        },
        "sk" : {
          "stringUnit" : {
