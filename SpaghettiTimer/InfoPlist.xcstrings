    "NSAlarmKitUsageDescription" : {
      "comment" : "Permission prompt shown the first time the app asks to schedule alarms.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Spaghetti Timer المنبّهات للرنين عند انتهاء مؤقتاتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer използва будилници, за да звъни, когато таймерите ви приключат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer používá budíky, aby zazvonil, když vaše časovače skončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer bruger alarmer til at ringe, når dine timere er færdige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer verwendet Wecker, um zu klingeln, wenn deine Timer ablaufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Spaghetti Timer χρησιμοποιεί ξυπνητήρια για να ηχήσει όταν λήγουν τα χρονόμετρά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer uses alarms to ring when your timers finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer usa alarmas para sonar cuando tus temporizadores terminan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer käyttää hälytyksiä soittaakseen, kun ajastimesi päättyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer utilise des alarmes pour sonner à la fin de vos minuteurs."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Spaghetti Timer ébresztőket használ, hogy jelezzen, amikor az időzítői lejárnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer usa le sveglie per suonare quando i tuoi timer terminano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer はタイマー終了時に鳴らすためアラームを使用します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer bruker alarmer for å ringe når tidtakerne dine er ferdige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer gebruikt wekkers om af te gaan wanneer je timers aflopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer używa alarmów, aby dzwonić po zakończeniu Twoich minutników."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spaghetti Timer usa alarmes para tocar quando os seus temporizadores terminam."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer folosește alarme pentru a suna când temporizatoarele tale se termină."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer использует будильники, чтобы звонить по завершении таймеров."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer používa budíky, aby zazvonil, keď vaše časovače skončia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer uporablja budilke, da zazvoni, ko se vaši časovniki iztečejo."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer koristi alarme da zazvoni kada se vaši tajmeri završe."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer koristi alarme da zazvoni kada se vaši tajmeri završe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaghetti Timer använder larm för att ringa när dina timers är klara."
          }
        }
      }
    }
